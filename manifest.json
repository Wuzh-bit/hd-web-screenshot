{
  "manifest_version": 3,
  "name": "网页截图助手",
  "version": "1.6.1",
  "description": "点击工具栏图标或按 Alt+Shift+S，即可对当前网页进行区域截图或整页截图，支持保存与复制到剪贴板。",
  "permissions": ["activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "网页截图（Alt+Shift+S）",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "take-screenshot": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "打开截图选择弹窗"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
